# Closed allowlist: everything is private unless explicitly included below.
/*
!/.gitignore
!/.npmrc
!/AGENTS.md
!/README.md
!/HANDOFF.md
!/start.cmd
!/package.json
!/package-lock.json
!/backend/
/backend/*
!/backend/*.py
!/backend/catalog.json
!/backend/phone-rules.json
!/backend/settings.example.json
!/frontend/
/frontend/*
!/frontend/*.html
!/frontend/*.js
!/frontend/*.css
!/frontend/assets/
/frontend/assets/*
!/frontend/assets/demo-header.svg
!/tests/
/tests/*
!/tests/test_api.py
!/tests/test_events_v4.py
!/tests/fixtures.example.json
!/tests/browser.cjs
!/tests/browser-v4.cjs
!/tests/seed_legacy_v4.py
!/handoff/
/handoff/*
!/handoff/audit.py
!/handoff/build_demo.py
!/demo/
/demo/*
!/demo/runtime.js
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
!/tests/pages.cjs

# Defense in depth, including nested files.
**/__pycache__/
**/node_modules/
**/.venv/
**/.env
**/.env.*
**/*.sqlite*
**/*.db
**/*.bak
**/*.backup
**/*.pdf
**/*.png
**/*.jpg
**/*.log
**/*.tmp
**/*.pem
**/*.key
**/settings.json
**/references/
